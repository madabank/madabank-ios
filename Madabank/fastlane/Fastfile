# Fastfile for Madabank iOS
# Documentation: https://docs.fastlane.tools
require 'base64'

default_platform(:ios)

platform :ios do
  # ==================== SETUP ====================
  
  # ==================== SETUP ====================
  
  before_all do
    setup_ci if ENV['CI']
  end

  # ==================== TESTING ====================
  
  desc "Run unit tests"
  lane :test do
    test_targets = {
      "Madabank" => "MadabankTests",
      "Core" => "CoreTests",
      "Networking" => "NetworkingTests",
      "Domain" => "DomainTests",
      "Data" => "DataTests",
      "CommonUITests" => "CommonUITests",
      "Auth" => "AuthTests",
      "Home" => "HomeTests",
      "Accounts" => "AccountsTests",
      "Cards" => "CardsTests",
      "Transactions" => "TransactionsTests",
      "Profile" => "ProfileTests",
      "Notifications" => "NotificationsTests"
    }

    test_targets.each do |scheme, test_target|
      scan(
        workspace: "Madabank.xcworkspace",
        scheme: scheme,
        destination: "platform=iOS Simulator,name=iPhone 16 Pro,OS=18.5",
        only_testing: [test_target],
        clean: true,
        result_bundle: true,
        code_coverage: true,
        output_directory: "./fastlane/test_output/#{scheme}"
      )
    end
  end

  desc "Run SwiftLint"
  lane :lint do
    swiftlint(
      mode: :lint,
      config_file: ".swiftlint.yml",
      raise_if_swiftlint_error: true,
      strict: true
    )
  end

  # ==================== CERTIFICATES ====================

  desc "Sync certificates and profiles (Read-only for CI)"
  lane :sync_certs do
    # Ensure you have set up Match repo and environment variables
    # MATCH_PASSWORD, MATCH_GIT_URL, git_private_key (SSH)
    
    # Use GH_TOKEN for basic auth if available to avoid prompt issues
    match_options = {
        readonly: false,
        clone_branch_directly: false,
        git_branch: "main"
    }
    
    if ENV['GH_TOKEN']
        match_options[:git_basic_authorization] = Base64.strict_encode64(":#{ENV['GH_TOKEN']}")
    end
    
    # Use keychain from setup_ci if available
    if is_ci
        keychain_path = lane_context[SharedValues::KEYCHAIN_PATH]
        if keychain_path
            match_options[:keychain_name] = keychain_path
            match_options[:keychain_password] = "" # setup_ci unlocks it
        end
    end
    
    match(match_options.merge(type: "appstore"))
    match(match_options.merge(type: "development"))
  end

  # ==================== BUILD ====================
  
  desc "Build the app for testing"
  lane :build do
    # sync_certs is not needed for simulator builds and causes issues on forks without secrets
    # sync_certs if is_ci
    
    gym(
      workspace: "Madabank.xcworkspace",
      scheme: "Madabank",
      configuration: "Debug",
      skip_archive: true,
      skip_codesigning: true,
      destination: "generic/platform=iOS Simulator"
    )
  end

  desc "Build for release"
  lane :build_release do
    sync_certs if is_ci
    
    gym(
      workspace: "Madabank.xcworkspace",
      scheme: "Madabank",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { 
          "online.darisadam.madabank" => ENV["sigh_online.darisadam.madabank_appstore_profile-name"]
        }
      },
      output_directory: "./build",
      output_name: "Madabank.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )
  end

  # ==================== CI/CD ====================
  
  desc "CI lane - runs tests and builds"
  lane :ci do
    lint
    test
    build
  end

  desc "Deploy to TestFlight"
  lane :beta do
    # ensure_git_status_clean unless is_ci
    
    api_key = nil
    if ENV["APP_STORE_CONNECT_API_KEY_KEY"]
        UI.message("Debug: Key ID present: #{!ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'].to_s.empty?}")
        UI.message("Debug: Key Content present: #{!ENV['APP_STORE_CONNECT_API_KEY_KEY'].to_s.empty?}")
        # Robustly handle different key formats (with/without headers, newlines, spaces)
        raw_api_key = ENV["APP_STORE_CONNECT_API_KEY_KEY"].to_s
        clean_key = raw_api_key.gsub("-----BEGIN PRIVATE KEY-----", "")
                               .gsub("-----END PRIVATE KEY-----", "")
                               .gsub("\\n", "")
                               .gsub("\n", "")
                               .gsub("\r", "")
                               .gsub(" ", "")
                               .strip
        
        # Reconstruct PEM format
        pem_key = "-----BEGIN PRIVATE KEY-----\n"
        pem_key += clean_key.scan(/.{1,64}/).join("\n")
        pem_key += "\n-----END PRIVATE KEY-----"
        
        api_key = app_store_connect_api_key(
            key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
            issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
            key_content: pem_key,
            is_key_content_base64: false,
            in_house: false
        )
    end
    
    # Increment build number
    current_build_number = latest_testflight_build_number(
      initial_build_number: 1,
      api_key: api_key
    )
    increment_build_number(build_number: current_build_number + 1)
    
    build_release
    
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: "Updated via Fastlane",
      api_key: api_key
    )
    
    # Commit build number bump
    if is_ci
      # Configure git user for CI
      git_user_email = ENV['GIT_USER_EMAIL'] || 'bot@madabank.art'
      git_user_name = ENV['GIT_USER_NAME'] || 'Madabank Bot'
      sh("git config user.email '#{git_user_email}'")
      sh("git config user.name '#{git_user_name}'")
    end
    
    commit_version_bump(
      message: "chore: Bump build number [skip ci]",
      force: true
    )
    
    push_to_git_remote
  end

  desc "Deploy to App Store"
  lane :release do
    ensure_git_status_clean
    
    build_release
    
    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false
    )
  end

  # ==================== UTILITIES ====================
  
  desc "Generate project using Tuist"
  lane :generate do
    Dir.chdir("..") do
      sh("tuist install")
      sh("tuist generate")
    end
  end

  desc "Clean build artifacts"
  lane :clean do
    clear_derived_data
    Dir.chdir("..") do
      sh("tuist clean")
    end
  end

  # ==================== ERROR HANDLING ====================
  
  error do |lane, exception|
    UI.error("Error in lane #{lane}: #{exception.message}")
  end
end
